# Local Docker MySQL 8 (loopback only). Copy to gitignored `.env` (Compose)
# and `.env.local` (Next.js / bun scripts).
# Production: managed MySQL with a unique password — never this compose file.
DATABASE_URL=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=
# Required. Generate with: openssl rand -base64 32
# Must be at least 32 characters. Never leave this empty in any environment.
BETTER_AUTH_SECRET=
# Local HTTP is fine. Production must be the public https origin (app refuses http).
BETTER_AUTH_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required for admin “Dịch sang tiếng Anh” (OpenAI).
# Create a secret key at https://platform.openai.com/api-keys
# Then add it here (or in gitignored `.env.local`) and restart `bun run dev`.
OPENAI_API_KEY=
# Storefront ISR (seconds). Default 60. Applied at `next build`.
STOREFRONT_REVALIDATE_SECONDS=

# SMTP for appointment notification emails. Required in production.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
