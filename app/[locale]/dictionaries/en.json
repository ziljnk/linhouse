    "about": {
      "label": "Ordering from abroad",
      "headline": "Four steps, all handled over chat",
      "body": "Built specifically for brides who can't walk into the atelier — everything runs through WhatsApp, Zalo or Messenger, in writing, with photos, so nothing gets lost in a phone call.",
      "steps": [
        {
          "number": "01",
          "title": "Send your measurements",
          "body": "We send a simple self-measurement guide with photo examples — no tailor visit needed."
        },
        {
          "number": "02",
          "title": "Chat consultation",
          "body": "We confirm silhouette, fabric, coverage and any custom changes over WhatsApp or Messenger — text and photos, at your own pace."
        },
        {
          "number": "03",
          "title": "We tailor by hand",
          "body": "Your gown is cut and sewn in our Ho Chi Minh City atelier, with progress photos along the way."
        },
        {
          "number": "04",
          "title": "Worldwide shipping",
          "body": "Packed, insured and tracked to your door, with customs paperwork handled on our end."
        }
      ]
    },
